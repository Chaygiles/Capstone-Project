-- SECTION 3: VALIDATE SOURCE MAPPINGS BEFORE UPDATE
-- A FALSE result violates the CHECK constraint and aborts the transaction.
-- Confirm that:
--   a) Every diagnosis has an entry in the source mapping.
--   b) Each diagnosis ID retains its original ICD-10 code.
--   c) Every source mapping matches a diagnosis record.
--   d) Every mapped encounter_id exists in encounters.
CREATE TEMP TABLE _diagnoses_repair_check (
    is_valid BOOLEAN NOT NULL CHECK (is_valid)
) ON COMMIT DROP;

INSERT INTO _diagnoses_repair_check (is_valid)
SELECT
    NOT EXISTS (
        SELECT 1
        FROM diagnoses AS d
        LEFT JOIN _diagnoses_encounter_mapping AS m
            ON d.diagnosis_id = m.diagnosis_id
        WHERE m.diagnosis_id IS NULL
           OR d.icd10_code IS DISTINCT FROM m.icd10_code
    )
    AND NOT EXISTS (
        SELECT 1
        FROM _diagnoses_encounter_mapping AS m
        LEFT JOIN diagnoses AS d
            ON m.diagnosis_id = d.diagnosis_id
        WHERE d.diagnosis_id IS NULL
    )
    AND NOT EXISTS (
        SELECT 1
        FROM _diagnoses_encounter_mapping AS m
        LEFT JOIN encounters AS e
            ON m.encounter_id = e.encounter_id
        WHERE e.encounter_id IS NULL
    );


-- SECTION 4: RESTORE ENCOUNTER IDS
-- Match on diagnosis_id and change only encounter_id.
-- IS DISTINCT FROM skips rows that already contain the correct value.
UPDATE diagnoses AS d
SET encounter_id = m.encounter_id
FROM _diagnoses_encounter_mapping AS m
WHERE d.diagnosis_id = m.diagnosis_id
  AND d.encounter_id IS DISTINCT FROM m.encounter_id;


-- SECTION 5: RECHECK UPDATED VALUES
-- Confirm that every saved diagnosis now has the expected encounter_id.
-- Any mismatch aborts the transaction before COMMIT.
INSERT INTO _diagnoses_repair_check (is_valid)
SELECT NOT EXISTS (
    SELECT 1
    FROM diagnoses AS d
    JOIN _diagnoses_encounter_mapping AS m
        ON d.diagnosis_id = m.diagnosis_id
    WHERE d.encounter_id IS DISTINCT FROM m.encounter_id
);

-- Save all changes only after validation succeeds.
COMMIT;


-- SECTION 6: POST-REPAIR VALIDATION
-- Expected: 14,989 diagnoses, 14,989 populated IDs, 0 invalid IDs.
SELECT
    COUNT(*) AS total_diagnoses,
    COUNT(d.encounter_id) AS populated_encounter_ids,
    COUNT(*) FILTER (WHERE e.encounter_id IS NULL) AS invalid_encounter_ids
FROM diagnoses AS d
LEFT JOIN encounters AS e
    ON d.encounter_id = e.encounter_id;

-- Preview 20 diagnosis records and their repaired encounter relationships.
SELECT
    d.diagnosis_id,
    d.encounter_id,
    d.icd10_code,
    d.diagnosis_category,
    d.primary_flag
FROM diagnoses AS d
JOIN encounters AS e
    ON d.encounter_id = e.encounter_id
ORDER BY d.diagnosis_id
LIMIT 20;
