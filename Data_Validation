-- NULL validation

--NULL Validations

SELECT e.appointment_id, a.appointment_id
FROM encounters e 
LEFT JOIN appointments a
	ON e.appointment_id = a.appointment_id
WHERE (e.appointment_id, a.appointment_id) IS NULL


/*
I began the NULL validation process by checking for missing values through individual table queries and JOINs. 
While this approach works, I recognized that repeating the same process across every table and required column would be inefficient and difficult to scale.

To make the validation process more efficient, I researched PostgreSQL metadata and learned to use information_schema to identify columns defined as NOT NULL. 
This lets me compare the database structure against the Data Dictionary and focus my validation on columns expected to contain values.
*/


/* NULL VALIDATION - REQUIRED COLUMNS 

I will be removing this from the capstone itself because I realized, while reviewing the Data Dictionary, which tables were already NULL and NOT NULL.


SELECT
    table_name,
    column_name,
    data_type,
    is_nullable
FROM information_schema.columns
WHERE table_schema = 'public'
  AND is_nullable = 'NO'
ORDER BY table_name, ordinal_position

*/ 

-- Checking for any missing zip codes in  the patients

SELECT first_name, last_name, zip_code
FROM pat
WHERE zip_code IS NULL

-- Finding the cities that have lowercase values 


SELECT first_name, last_name, city
FROM pat
WHERE city = LOWER(city)



 /*The Data Dictionary identified 20 patients with intentionally duplicated
demographic attributes. I checked first_name, last_name, and DOB to identify them.*/


SELECT first_name, last_name, DOB,
    COUNT(*) AS duplicate_count
FROM pat
GROUP BY first_name,last_name,DOB
HAVING COUNT(*) > 1
 
