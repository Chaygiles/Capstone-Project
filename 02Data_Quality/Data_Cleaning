
/*
========================================================
DATA CLEANING: DUPLICATE PATIENT RECORDS
========================================================

BUSINESS PROBLEM:
Duplicate patient records can cause inaccurate patient
counts, fragmented medical histories, and misleading
healthcare reporting.

OBJECTIVE:
Identify and remove confirmed duplicate patients while
preserving their related healthcare records.

APPROACH:
1. Identify patients with matching demographic information.
2. Investigate potential duplicates before merging.
3. Create a temporary duplicate-to-original ID mapping.
4. Identify foreign key relationships involving patients.
5. Reassign related records to the retained patient ID.
6. Delete duplicate patient records.
7. Validate the results before committing changes.

TABLES USED:
- pat
- appointments
- encounters
- claims
- payments
- medications

========================================================
*/


/*
========================================================
SECTION 1: IDENTIFY POTENTIAL DUPLICATES
========================================================

Group patients by first name, last name, and DOB.

HAVING COUNT(*) > 1 identifies demographic combinations
that appear more than once.

patid is excluded from GROUP BY because duplicate
patients can have different patient IDs.

Matching names and DOBs indicate possible duplicates,
not necessarily the same individual.
*/

SELECT first_name, last_name, dob,
    COUNT(*) AS duplicate_count
FROM pat
GROUP BY first_name, last_name, dob
HAVING COUNT(*) > 1
ORDER BY last_name, first_name;


/*
INVESTIGATE INDIVIDUAL RECORDS

Evelyn Allen appeared multiple times in the initial
results. Further review showed that not every record
represented the same patient.

Additional demographic fields, including sex and
location, were reviewed to distinguish patients.
*/

SELECT *
FROM pat
WHERE first_name = 'Evelyn'
    AND last_name = 'Allen';


-- Compare the two patient records investigated.

SELECT *
FROM pat
WHERE patid IN (407, 1518);


/*
========================================================
SECTION 2: IDENTIFY FOREIGN KEY RELATIONSHIPS
========================================================

During the original cleaning process, attempting to
delete duplicate patients caused foreign key errors.

Payments and medications were among the tables that
still referenced duplicate patient IDs.

I used AI assistance to construct the information_schema
query below and reviewed its results to identify the
tables referencing pat.patid.

FINDINGS:
The following tables reference pat.patid:

- appointments
- encounters
- claims
- payments
- medications

These relationships must be preserved before deleting
duplicate patient records.
*/

SELECT
    tc.table_name,
    kcu.column_name,
    ccu.table_name AS referenced_table,
    ccu.column_name AS referenced_column
FROM information_schema.table_constraints tc
JOIN information_schema.key_column_usage kcu
    ON tc.constraint_name = kcu.constraint_name
    AND tc.constraint_schema = kcu.constraint_schema
JOIN information_schema.constraint_column_usage ccu
    ON tc.constraint_name = ccu.constraint_name
    AND tc.constraint_schema = ccu.constraint_schema
WHERE tc.constraint_type = 'FOREIGN KEY'
    AND ccu.table_name = 'pat'
    AND ccu.column_name = 'patid';


/*
========================================================
SECTION 3: CREATE DUPLICATE PATIENT MAPPING
========================================================

Create a temporary table to map duplicate patient IDs
to the patient ID that will be retained.

MIN(patid) OVER (PARTITION BY...) selects the lowest
patient ID within each matching demographic group.

Matching fields:
- First name and last name
- Date of birth
- Sex
- City, state, and ZIP code

The temporary table allows this mapping to be reused
when updating related healthcare tables.

IMPORTANT:
Only proceed after reviewing and confirming that
the matching records represent the same patient.

BEGIN starts a transaction so changes can be rolled
back if validation identifies a problem.
*/

BEGIN;

CREATE TEMP TABLE duplicate_patients
ON COMMIT DROP AS
SELECT patid AS duplicate_patid,
    MIN(patid) OVER (
        PARTITION BY first_name, last_name, dob,
                     sex, city, state, zip_code
    ) AS keep_patid
FROM pat;


/*
The mapping initially includes every patient, including
those whose patid is already the ID being retained.

Remove these self-mappings so only duplicate IDs remain.

duplicate_patid = Patient ID to remove
keep_patid      = Patient ID to retain
*/

DELETE FROM duplicate_patients
WHERE duplicate_patid = keep_patid;


-- Review and confirm the duplicate mappings.

SELECT *
FROM duplicate_patients
ORDER BY keep_patid, duplicate_patid;


/*
========================================================
SECTION 4: UPDATE RELATED PATIENT RECORDS
========================================================

Reassign all records referencing duplicate patient IDs
to their corresponding retained patient IDs.

UPDATE ... FROM joins each child table to the
temporary duplicate_patients mapping.

Only records matching duplicate_patid are updated.

This preserves related healthcare records and maintains
referential integrity before removing duplicate patients.
*/


-- Update appointments.

UPDATE appointments a
SET patid = d.keep_patid
FROM duplicate_patients d
WHERE a.patid = d.duplicate_patid;


-- Update encounters.

UPDATE encounters e
SET patid = d.keep_patid
FROM duplicate_patients d
WHERE e.patid = d.duplicate_patid;


-- Update claims.

UPDATE claims c
SET patid = d.keep_patid
FROM duplicate_patients d
WHERE c.patid = d.duplicate_patid;


-- Update payments.

UPDATE payments p
SET patid = d.keep_patid
FROM duplicate_patients d
WHERE p.patid = d.duplicate_patid;


-- Update medications.

UPDATE medications m
SET patid = d.keep_patid
FROM duplicate_patients d
WHERE m.patid = d.duplicate_patid;


/*
========================================================
SECTION 5: REMOVE DUPLICATE PATIENTS
========================================================

After reassigning related records, remove the duplicate
patient IDs from the original pat table.

DELETE ... USING matches records in pat against
the temporary mapping.

Only duplicate_patid records are deleted.
*/

DELETE FROM pat p
USING duplicate_patients d
WHERE p.patid = d.duplicate_patid;


/*
========================================================
SECTION 6: VALIDATE DUPLICATE REMOVAL
========================================================

VALIDATION 1:
Confirm that none of the duplicate patient IDs
remain in the pat table.

EXPECTED RESULT: 0 rows.
*/

SELECT *
FROM pat
WHERE patid IN (
    SELECT duplicate_patid
    FROM duplicate_patients
);


/*
VALIDATION 2:
Check whether identical demographic combinations
still appear more than once.

EXPECTED RESULT:
0 rows for confirmed duplicate records that were
included in the cleaning process.
*/

SELECT first_name, last_name, dob,
    sex, city, state, zip_code,
    COUNT(*) AS duplicate_count
FROM pat
GROUP BY first_name, last_name, dob,
    sex, city, state, zip_code
HAVING COUNT(*) > 1;


/*
========================================================
FINAL REVIEW
========================================================

Confirm that:
1. The duplicate mapping contains only verified patients.
2. Related healthcare records were reassigned correctly.
3. No targeted duplicate patient IDs remain.
4. No unexpected duplicate demographic groups remain.

Run COMMIT after confirming the results.

If a problem is identified, run ROLLBACK instead.

The temporary mapping table is automatically removed
when the transaction is committed.
========================================================
*/

-- COMMIT;
-- ROLLBACK;
